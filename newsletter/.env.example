# Newsletter System — Environment Variables
# Copy this file to .env.local and fill in all values before running.

# Already have this from news_pipeline
GROQ_API_KEY=your_groq_api_key_here

# Supabase — use the SERVICE ROLE key (not anon key), server-side only
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend — from resend.com dashboard
RESEND_API_KEY=re_your_key_here
RESEND_FROM=newsletter@yourdomain.com   # Must be from your verified domain
RESEND_REPLY_TO=hello@yourdomain.com    # Optional

# Your site (used in confirmation + unsubscribe links)
SITE_URL=https://yourdomain.com
