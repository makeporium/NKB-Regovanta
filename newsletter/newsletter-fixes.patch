+// ── Confirmation helpers ───────────────────────────────────────────────────────
+
+/** Confirmation links stop working after this long (matches the email copy). */
+const CONFIRM_TOKEN_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+
+function isTokenExpired(issuedAt: string | null | undefined): boolean {
+    if (!issuedAt) return true;
+    return Date.now() - new Date(issuedAt).getTime() > CONFIRM_TOKEN_TTL_MS;
+}
+
+/** Sends the confirmation email. Returns true on success. Resend reports errors
+ *  in its return value rather than throwing, so we check `error` explicitly. */
+async function sendConfirmationEmail(email: string, confirmToken: string): Promise<boolean> {
+    const confirmUrl = `${siteUrl()}/confirm?token=${confirmToken}`;
+    const { error } = await getResend().emails.send({
+        from: fromAddress(),
+        to: email,
+        subject: "Confirm your NKB Regovanta newsletter subscription",
+        html: confirmationEmailHtml(confirmUrl),
+    });
+    if (error) {
+        console.error("[subscribe] email send error:", error);
+        return false;
+    }
+    return true;
+}
+
+/** Issues a fresh confirm token for an existing row and sets it back to pending. */
+async function reissueConfirmToken(email: string): Promise<string | null> {
+    const { data, error } = await supabase
+        .from("subscribers")
+        .update({
+            status: "pending",
+            confirm_token: crypto.randomUUID(),
+            token_issued_at: new Date().toISOString(),
+            confirmed_at: null,
+        })
+        .eq("email", email)
+        .select("confirm_token")
+        .single();
+    if (error || !data) {
+        console.error("[subscribe] token reissue error:", error);
+        return null;
+    }
+    return data.confirm_token;
+}
+
+const SEND_FAILED = { ok: false, message: "Could not send confirmation email. Please try again." };
+const GENERIC_FAILED = { ok: false, message: "Something went wrong. Please try again." };
