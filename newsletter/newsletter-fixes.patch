+-- 5. Unsubscribe token + confirmation-link expiry
+--    Safe to run on a table that already exists (columns are added only if missing).
+--    unsubscribe_token: secret per-subscriber token used in unsubscribe links,
+--      so nobody can unsubscribe someone else just by knowing their email.
+--    token_issued_at: when the current confirm_token was issued; confirmation
+--      links older than 7 days are rejected and a fresh one is sent on re-signup.
+alter table subscribers
+  add column if not exists unsubscribe_token uuid not null default gen_random_uuid();
+alter table subscribers
+  add column if not exists token_issued_at timestamptz not null default now();
+
+create unique index if not exists idx_subscribers_unsubscribe_token
+  on subscribers (unsubscribe_token);
