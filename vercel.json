      "destination": "/insights/how-to-register-medical-device-in-india",
      "permanent": true
    },
    {
      "source": "/services/regulatory-affairs",
      "destination": "/services/global-medical-device-ivd-regulatory-affairs-consulting",
      "permanent": true
    },
    {
      "source": "/services/drug-device-combination-products",
      "destination": "/services/drug-device-combination-product-consulting",
      "permanent": true
    },
    {
      "source": "/services/regulatory-due-diligence",
      "destination": "/services/medical-device-ivd-regulatory-due-diligence",
      "permanent": true
    },
    {
      "source": "/services/wpc-wireless-medical-devices",
      "destination": "/services/wpc-approval-wireless-medical-devices-india",
      "permanent": true
    },
    {
      "source": "/services/pc-pndt-certificate",
      "destination": "/services/pc-pndt-registration-consultant-certificate-india",
      "permanent": true
    },
    {
      "source": "/services/iec-ad-code",
      "destination": "/services/iec-ad-code-registration-india",
      "permanent": true
    },
    {
      "source": "/services/drug-licenses-for-importers",
      "destination": "/services/drug-licenses-importers-india-form-10-form-41",
