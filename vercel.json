    },
    {
      "source": "/services/iso-13485",
      "destination": "/services/iso-13485-implementation-certification-consulting",
      "permanent": true
    },
    {
      "source": "/services/technical-documentation",
      "destination": "/services/medical-device-technical-documentation-consulting",
      "permanent": true
    },
    {
      "source": "/services/market-access",
      "destination": "/services/global-market-access-consulting-medical-devices",
